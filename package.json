{
  "name": "qling-crossborder-insight",
  "version": "0.1.0",
  "description": "Evidence-linked AI market intelligence prototype for cross-border sellers",
  "author": "Team Qling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --dir",
    "desktop": "npm run build && electron electron/main.mjs",
    "eval": "vitest run src/evaluation",
    "test:server": "node --test server/*.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run test:server && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "cn.qling.crossborderinsight",
    "productName": "Qling Cross-border Insight",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["portable"] }
  }
}
