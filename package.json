{
  "name": "qling-crossborder-insight",
  "version": "0.1.0",
  "description": "Evidence-linked AI market intelligence prototype for cross-border sellers",
  "author": "Team Qling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --dir",
    "build:desktop:verify": "npm run build && electron-builder --dir --config.directories.output=desktop-verify",
    "smoke:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1",
    "desktop": "npm run build && electron electron/main.mjs",
    "eval": "tsx scripts/evaluate-golden.ts",
    "review:prepare": "tsx scripts/prepare-human-review.ts",
    "review:audit": "node scripts/audit-human-review.mjs",
    "test:e2e": "playwright test",
    "test:server": "node --test server/*.test.mjs scripts/*.node-test.mjs electron/*.node-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run test:server && npm run build",
    "check:all": "npm run check && npm run eval && npm run test:e2e",
    "prepare:submission": "npm run build && node scripts/prepare-submission.mjs && node scripts/verify-submission.mjs",
    "validate:submission": "node scripts/validate-submission-fields.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@playwright/test": "^1.54.0",
    "archiver": "^7.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.0",
    "yauzl-promise": "^4.0.0"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "cn.qling.crossborderinsight",
    "productName": "Qling Cross-border Insight",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["portable"] }
  }
}
